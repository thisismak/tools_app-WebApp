<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <title>後台 - 生字管理</title>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container mt-5">
    <h2 class="text-center text-white">生字管理</h2>
    <table class="table table-dark table-striped mt-4">
      <thead>
        <tr>
          <th>生字庫ID</th>
          <th>生字庫名稱</th>
          <th>用戶</th>
          <th>生字數量</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% wordlists.forEach(wordlist => { %>
          <tr>
            <td><%= wordlist.id %></td>
            <td><%= wordlist.name %></td>
            <td><%= wordlist.username %></td>
            <td><%= wordlist.word_count %></td>
            <td>
              <button class="btn btn-sm btn-primary me-2" onclick="viewWords('<%= wordlist.id %>')">查看生字</button>
              <button class="btn btn-sm btn-danger" onclick="deleteWordlist('<%= wordlist.id %>')">刪除</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- 查看生字模態框 -->
  <div class="modal fade" id="viewWordsModal" tabindex="-1" aria-labelledby="viewWordsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content bg-dark text-white">
        <div class="modal-header">
          <h5 class="modal-title" id="viewWordsModalLabel">生字列表</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
        </div>
        <div class="modal-body">
          <table class="table table-dark">
            <thead>
              <tr>
                <th>英文</th>
                <th>中文</th>
              </tr>
            </thead>
            <tbody id="wordListBody"></tbody>
          </table>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function viewWords(wordlistId) {
      fetch(`/admin/dictation/words/${wordlistId}`)
        .then(response => response.json())
        .then(data => {
          const wordListBody = document.getElementById('wordListBody');
          wordListBody.innerHTML = '';
          data.forEach(word => {
            const tr = document.createElement('tr');
            tr.innerHTML = `<td>${word.english}</td><td>${word.chinese}</td>`;
            wordListBody.appendChild(tr);
          });
          const modal = new bootstrap.Modal(document.getElementById('viewWordsModal'));
          modal.show();
        })
        .catch(err => {
          alert('載入生字失敗: ' + err.message);
        });
    }

    function deleteWordlist(id) {
      if (!confirm('確定要刪除此生字庫嗎？')) return;
      fetch(`/admin/dictation/${id}`, {
        method: 'DELETE'
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            alert('生字庫已刪除！');
            window.location.reload();
          } else {
            alert(data.error || '刪除生字庫失敗');
          }
        })
        .catch(err => {
          alert('刪除生字庫失敗: ' + err.message);
        });
    }
  </script>
</body>
</html>