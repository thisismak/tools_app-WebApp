<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <title>後台 - SEO管理</title>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container mt-5">
    <h2 class="text-center text-white">SEO管理</h2>
    <form id="seoForm" class="mt-4">
      <h4 class="text-white">首頁設定</h4>
      <div class="mb-3">
        <label for="index_meta_description" class="form-label text-white">Meta Description</label>
        <textarea id="index_meta_description" name="index_meta_description" class="form-control" rows="3"><%= settings.index_meta_description %></textarea>
      </div>
      <div class="mb-3">
        <label for="index_meta_keywords" class="form-label text-white">Meta Keywords</label>
        <input type="text" id="index_meta_keywords" name="index_meta_keywords" class="form-control" value="<%= settings.index_meta_keywords %>">
      </div>
      <div class="mb-3">
        <label for="index_og_title" class="form-label text-white">OG Title</label>
        <input type="text" id="index_og_title" name="index_og_title" class="form-control" value="<%= settings.index_og_title %>">
      </div>
      <div class="mb-3">
        <label for="index_og_description" class="form-label text-white">OG Description</label>
        <textarea id="index_og_description" name="index_og_description" class="form-control" rows="3"><%= settings.index_og_description %></textarea>
      </div>
      <h4 class="text-white mt-4">登入頁設定</h4>
      <div class="mb-3">
        <label for="login_meta_description" class="form-label text-white">Meta Description</label>
        <textarea id="login_meta_description" name="login_meta_description" class="form-control" rows="3"><%= settings.login_meta_description %></textarea>
      </div>
      <div class="mb-3">
        <label for="login_meta_keywords" class="form-label text-white">Meta Keywords</label>
        <input type="text" id="login_meta_keywords" name="login_meta_keywords" class="form-control" value="<%= settings.login_meta_keywords %>">
      </div>
      <div class="mb-3">
        <label for="login_og_title" class="form-label text-white">OG Title</label>
        <input type="text" id="login_og_title" name="login_og_title" class="form-control" value="<%= settings.login_og_title %>">
      </div>
      <div class="mb-3">
        <label for="login_og_description" class="form-label text-white">OG Description</label>
        <textarea id="login_og_description" name="login_og_description" class="form-control" rows="3"><%= settings.login_og_description %></textarea>
      </div>
      <h4 class="text-white mt-4">註冊頁設定</h4>
      <div class="mb-3">
        <label for="register_meta_description" class="form-label text-white">Meta Description</label>
        <textarea id="register_meta_description" name="register_meta_description" class="form-control" rows="3"><%= settings.register_meta_description %></textarea>
      </div>
      <div class="mb-3">
        <label for="register_meta_keywords" class="form-label text-white">Meta Keywords</label>
        <input type="text" id="register_meta_keywords" name="register_meta_keywords" class="form-control" value="<%= settings.register_meta_keywords %>">
      </div>
      <div class="mb-3">
        <label for="register_og_title" class="form-label text-white">OG Title</label>
        <input type="text" id="register_og_title" name="register_og_title" class="form-control" value="<%= settings.register_og_title %>">
      </div>
      <div class="mb-3">
        <label for="register_og_description" class="form-label text-white">OG Description</label>
        <textarea id="register_og_description" name="register_og_description" class="form-control" rows="3"><%= settings.register_og_description %></textarea>
      </div>
      <button type="submit" class="btn btn-primary w-100">儲存</button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById('seoForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const settings = {};
      ['index_meta_description', 'index_meta_keywords', 'index_og_title', 'index_og_description',
       'login_meta_description', 'login_meta_keywords', 'login_og_title', 'login_og_description',
       'register_meta_description', 'register_meta_keywords', 'register_og_title', 'register_og_description']
        .forEach(key => {
          settings[key] = document.getElementById(key).value.trim();
        });
      fetch('/admin/seo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(settings)
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            alert('SEO設定已更新！');
            window.location.reload();
          } else {
            alert(data.error || '更新SEO設定失敗');
          }
        })
        .catch(err => {
          alert('更新SEO設定失敗: ' + err.message);
        });
    });
  </script>
</body>
</html>