<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <title>後台 - 系統設定</title>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container mt-5">
    <h2 class="text-center text-white">系統設定</h2>
    <form id="settingsForm" class="mt-4">
      <div class="mb-3">
        <label for="site_title" class="form-label text-white">站點標題</label>
        <input type="text" id="site_title" name="site_title" class="form-control" value="<%= settings.site_title %>" required>
      </div>
      <div class="mb-3">
        <label for="vapid_public_key" class="form-label text-white">VAPID 公鑰</label>
        <input type="text" id="vapid_public_key" name="vapid_public_key" class="form-control" value="<%= settings.vapid_public_key %>" required>
      </div>
      <button type="submit" class="btn btn-primary w-100">儲存</button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById('settingsForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const site_title = document.getElementById('site_title').value.trim();
      const vapid_public_key = document.getElementById('vapid_public_key').value.trim();
      if (!site_title || !vapid_public_key) {
        alert('請填寫所有欄位！');
        return;
      }
      fetch('/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ site_title, vapid_public_key })
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            alert('設定已更新！');
            window.location.reload();
          } else {
            alert(data.error || '更新設定失敗');
          }
        })
        .catch(err => {
          alert('更新設定失敗: ' + err.message);
        });
    });
  </script>
</body>
</html>