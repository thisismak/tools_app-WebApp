<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment-timezone/0.5.45/moment-timezone-with-data.min.js"></script>
  <title>後台 - 任務管理</title>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container mt-5">
    <h2 class="text-center text-white">任務管理</h2>
    <table class="table table-dark table-striped mt-4">
      <thead>
        <tr>
          <th>ID</th>
          <th>標題</th>
          <th>描述</th>
          <th>用戶</th>
          <th>到期時間</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% tasks.forEach(task => { %>
          <tr>
            <td><%= task.id %></td>
            <td><%= task.title %></td>
            <td><%= task.description || '無' %></td>
            <td><%= task.username %></td>
            <td><%= moment(task.due_date).tz('Asia/Hong_Kong').format('YYYY-MM-DD HH:mm') %></td>
            <td>
              <button class="btn btn-sm btn-danger" onclick="deleteTask('<%= task.id %>')">刪除</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function deleteTask(id) {
      if (!confirm('確定要刪除此任務嗎？')) return;
      fetch(`/admin/tasks/${id}`, {
        method: 'DELETE'
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            alert('任務已刪除！');
            window.location.reload();
          } else {
            alert(data.error || '刪除任務失敗');
          }
        })
        .catch(err => {
          alert('刪除任務失敗: ' + err.message);
        });
    }
  </script>
</body>
</html>