<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <%- include('partials/pwa') %>
  <title>技術人員內部網站 - 首頁</title>
</head>
<body class="min-vh-100" style="background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);">
  <!-- 導航欄 -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
    <div class="container">
      <a class="navbar-brand" href="/">技術人員內部網站</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link active" href="#home">首頁</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#features">功能</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#about">關於</a>
          </li>
          <li class="nav-item">
            <a class="nav-link btn btn-primary text-white px-3 py-1 ms-2" href="/login">登入</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- 首頁區塊 -->
  <section id="home" class="d-flex align-items-center justify-content-center min-vh-100 pt-5">
    <div class="container text-center text-white">
      <h1 class="display-4 fw-bold mb-4">歡迎來到技術人員內部網站</h1>
      <p class="lead mb-4">一個專為技術人員設計的學習與管理平台，助您高效掌握英文生字！</p>
      <a href="/login" class="btn btn-primary btn-lg">立即開始</a>
    </div>
  </section>

  <!-- 功能介紹 -->
  <section id="features" class="py-5">
    <div class="container">
      <h2 class="text-center text-white mb-5">核心功能</h2>
      <div class="row">
        <div class="col-md-4 mb-4">
          <div class="container bg-white bg-opacity-10 border border-light border-opacity-20 rounded p-4 shadow">
            <h3 class="text-white">生字庫管理</h3>
            <p class="text-white text-opacity-75">創建、編輯和刪除您的專屬英文生字庫，輕鬆管理學習內容。</p>
          </div>
        </div>
        <div class="col-md-4 mb-4">
          <div class="container bg-white bg-opacity-10 border border-light border-opacity-20 rounded p-4 shadow">
            <h3 class="text-white">背默練習</h3>
            <p class="text-white text-opacity-75">通過互動式測驗，快速記憶英文單字及其中文解釋。</p>
          </div>
        </div>
        <div class="col-md-4 mb-4">
          <div class="container bg-white bg-opacity-10 border border-light border-opacity-20 rounded p-4 shadow">
            <h3 class="text-white">語音輔助</h3>
            <p class="text-white text-opacity-75">使用語音功能聆聽單字發音，提升學習效率。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 關於區塊 -->
  <section id="about" class="py-5 bg-dark bg-opacity-50">
    <div class="container">
      <h2 class="text-center text-white mb-5">關於我們</h2>
      <div class="container bg-white bg-opacity-10 border border-light border-opacity-20 rounded p-4 shadow">
        <p class="text-white text-opacity-75">
          技術人員內部網站由 [您的姓名] 開發，旨在為技術人員提供一個高效的學習工具，專注於英文生字的掌握。
          平台結合了現代化技術和直觀的設計，幫助用戶提升語言能力，助力職業發展。
        </p>
      </div>
    </div>
  </section>

  <!-- 聯繫區塊 -->
  <section id="contact" class="py-5">
    <div class="container">
      <h2 class="text-center text-white mb-5">聯繫我們</h2>
      <div class="container bg-white bg-opacity-10 border border-light border-opacity-20 rounded p-4 shadow">
        <p class="text-white text-opacity-75 text-center">
          有任何問題或建議？請聯繫我們：<br>
          電子郵件: <a href="mailto:[您的電子郵件]" class="text-info">[您的電子郵件]</a><br>
          GitHub: <a href="https://github.com/thisismak" class="text-info">thisismak</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 頁腳 -->
  <footer class="bg-dark text-white text-center py-3">
    <p>&copy; 2025 技術人員內部網站。版權所有。</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>